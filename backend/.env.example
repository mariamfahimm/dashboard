# Environment Configuration
NODE_ENV=development
ALLOW_DEMO_SEED=true

# Database Configuration
# Use DATABASE_URL for Docker MongoDB setup
DATABASE_URL=mongodb://demo_user:demo_pass@localhost:27017/educonnect_demo?authSource=admin

# Alternative: Use MONGO_URI for other MongoDB setups
# MONGO_URI=mongodb://localhost:27017/educonnect

# Server Configuration
PORT=4000
FRONTEND_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d
