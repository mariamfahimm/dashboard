{
  "name": "educonnect-backend",
  "version": "1.0.0",
  "description": "EduConnect Parental Dashboard Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "setup-db": "node scripts/setupDatabase.js",
    "seed:demo": "ts-node -r tsconfig-paths/register scripts/seedDemo.ts",
    "seed:emma": "ts-node -r tsconfig-paths/register scripts/seedEmma.ts",
    "seed:jana": "ts-node -r tsconfig-paths/register scripts/seedJana.ts",
    "seed:all-grades": "ts-node -r tsconfig-paths/register scripts/seedAllGrades.ts",
    "seed:existing-grades": "ts-node -r tsconfig-paths/register scripts/seedGradesForExistingStudents.ts",
    "seed:focus-group": "ts-node -r tsconfig-paths/register scripts/setupFocusGroupAccounts.ts",
    "seed:complete": "ts-node -r tsconfig-paths/register scripts/seedCompleteTestData.ts",
    "validate-db": "ts-node -r tsconfig-paths/register scripts/validate-db-connection.ts",
    "verify": "ts-node -r tsconfig-paths/register scripts/verifyEndpoints.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "education",
    "dashboard",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/socket.io": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
